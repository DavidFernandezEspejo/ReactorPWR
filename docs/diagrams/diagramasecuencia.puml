@startumlactor "EventEngine\n(Bucle de Tiempo)" as Motorparticipant "PhysicsEngine\n(Numba JIT)" as Fisicaparticipant "CoreState\n(Pydantic)" as EstadoMotor -> Fisica : simulate_neutron_batch(active_neutrons, control_rods_pct)activate Fisicanote right of Fisica: Suceso Interaccion\n(Montecarlo Estocastico)Fisica --> Motor : (producidos, destruidos)deactivate FisicaMotor -> Fisica : calculate_keff(producidos, destruidos)activate FisicaFisica --> Motor : keff_instantaneodeactivate FisicaMotor -> Fisica : calculate_thermodynamics(producidos, coolant_flow)activate Fisicanote right of Fisica: Suceso Transferencia EnergeticaFisica --> Motor : (nueva_temp, nueva_potencia)deactivate FisicaMotor -> Estado : asignar active_neutrons, keff, nueva_temp, nueva_potenciaactivate EstadoEstado -> Estado : check_scram_condition()note right of Estado: Ajuste barras /\nParada Emergencia (SCRAM)Estado --> Motor : estado_validadodeactivate EstadoMotor -> Motor : t = t + dt@enduml